# Chave da API do Google Gemini (obtenha em https://aistudio.google.com/apikey)
# Em produção (Cloudflare Pages), configure esta variável como Secret em:
# Settings > Environment variables > GEMINI_API_KEY
GEMINI_API_KEY=

# Opcional: sobrescrever o modelo padrão (padrão: gemini-3.5-flash-lite com fallback automático)
# GEMINI_MODEL=gemini-3.5-flash-lite

# Opcional: porta do servidor local (npm run dev)
# PORT=8788
